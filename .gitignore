# ==============================================================================
# Git Ignore Configuration for RAG Model Project
# ==============================================================================

# --- Python Virtual Environments (Crucial: prevents pushing 50k+ library files) ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
*.venv/

# --- Byte-compiled / Optimized / C extensions ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# --- Environment Secrets & Credentials (NEVER push secrets) ---
.env
.env*.local
.env.development
.env.production
# Keep the example template file tracked
!.env.example

# --- Vector Databases & Embeddings Storage (Binary / dynamic data) ---
chroma_db/
**/chroma_db/
chroma_db_eval/
**/chroma_db_eval/
*.sqlite
*.sqlite3
*.db
*.faiss
*.index

# --- Logs & Test Artifacts ---
*.log
**/ollama_test.log
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# --- Node.js & Package Managers (if used) ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDEs & Code Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
